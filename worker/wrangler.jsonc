{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "attendr-interactions",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "workers_dev": true,
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "attendr-study",
      "database_id": "REPLACE_AFTER_D1_CREATE"
    }
  ]
}
