# Canvas origin only; do not include /api/v1 or a course path.
CANVAS_BASE_URL=https://school.instructure.com
CANVAS_API_TOKEN=replace_with_your_personal_token

CANVAS_LOOKAHEAD_DAYS=30
CANVAS_ANNOUNCEMENT_DAYS=14
APP_TIMEZONE=America/Toronto
# Automatically download Canvas syllabus pages and syllabus/course-outline PDFs.
CANVAS_MATERIALS_DIR=data/materials
CANVAS_MATERIALS_INDEX=data/materials_index.json
CANVAS_MATERIAL_MAX_MB=25
CANVAS_MATERIAL_FUTURE_DAYS=550
COURSE_SCHEDULE_FILE=data/course_schedule.json
ANNOUNCEMENT_DATES_INDEX=data/announcement_dates_index.json
LECTURE_QUIZ_RETRY_HOURS=336
# Cloud downloads stream to disk; only extracted text enters encrypted state.
LECTURE_MAX_FILE_MB=768

# Keep this URL secret: it grants permission to post in your Discord channel.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace_with_your_webhook
# Shared durable state. Scheduled runs override this with ATTENDR_HOME/attendr.db.
ATTENDR_DB=data/attendr.db
DISCORD_TIMEOUT_SECONDS=15
DISCORD_MAX_ATTEMPTS=4
DISCORD_MAX_RATE_LIMIT_WAIT_SECONDS=60
DISCORD_ALERT_HOURS=72
DISCORD_DIGEST_HOURS=72
DISCORD_BOT_TOKEN=replace_with_your_private_bot_token
DISCORD_APPLICATION_ID=replace_with_your_application_id
DISCORD_PUBLIC_KEY=replace_with_your_application_public_key
DISCORD_STUDY_CHANNEL_ID=replace_with_your_study_channel_id
DISCORD_ANNOUNCEMENTS_CHANNEL_ID=replace_with_your_announcements_channel_id
DISCORD_CALENDAR_CHANNEL_ID=replace_with_your_calendar_updates_channel_id
DISCORD_QUIZ_CHANNEL_ID=replace_with_your_lecture_quizzes_channel_id
DISCORD_OWNER_USER_ID=replace_with_your_user_id

# Google Calendar OAuth files stay local and must never be committed.
# Authorize explicitly with: .venv/bin/python scripts/setup_google.py
# Pipeline authentication is always noninteractive; browser setup waits at most 120s.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
# Leave both values blank to use the primary calendar.
GOOGLE_CALENDAR_NAME=College Deadlines
GOOGLE_CALENDAR_ID=
GOOGLE_CREATE_CALENDAR_IF_MISSING=true
GOOGLE_MARK_SUBMITTED=true
GOOGLE_SUBMITTED_COLOR_ID=10
GOOGLE_EVENT_DURATION_MINUTES=30
GOOGLE_STUDY_CALENDAR_NAME=Attendr Study Plan

# 24/7 study-session interaction service. Leave blank until deployed.
STUDY_WORKER_URL=
STUDY_SYNC_SECRET=

# Create a free key at https://aistudio.google.com/app/apikey and keep it secret.
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_INPUT_CHARS=120000
# Optional quiz source. A date-specific entry in DAILY_TOPICS_FILE takes precedence
# only when DAILY_QUIZ_TOPIC is blank.
DAILY_QUIZ_TOPIC=
DAILY_TOPICS_FILE=data/daily_topics.json

# Optional preferences: study windows/durations/priorities, triage, spaced review.
# Scheduled runners may point this to a private file outside the checkout.
ATTENDR_PREFERENCES_FILE=data/preferences.json

# Course assistant: setup_ask.py creates/reuses the dedicated channel.
# Upload the channel ID and existing Gemini key/model to Worker secrets.
DISCORD_ASK_CHANNEL_ID=
# Enabled by the scheduled workflow; opt in for local full runs.
ATTENDR_ASK_SYNC=false

# Optional, separate account authorization for restricted lecture slides
GOOGLE_SLIDES_TOKEN_FILE=google_slides_token.json
